{
  // The server side: server.js, lib/, scripts/, desktop/ and the shared types in types/ (the tests: tsconfig.test.json). Checked only (noEmit):
  // Node runs .ts files itself, so there is no build (docs/typescript-migration.md, D1). Every JavaScript file is checked
  // (checkJs; the annotations are JSDoc until Phase 3 renames the files); erasableSyntaxOnly and .ts import specifiers
  // keep every file loadable by Node as it is.
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["server.js", "lib", "scripts", "desktop", "types"],
  "exclude": ["node_modules", "test/fixtures", "types/page.ts"]
}
