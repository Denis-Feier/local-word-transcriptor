{
  "name": "local-word-transcriptor",
  "productName": "Live Transcriber",
  "version": "1.0.1",
  "description": "Live Romanian speech-to-text from your laptop mic, fully local",
  "type": "module",
  "private": true,
  "main": "desktop/main.ts",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "start": "node server.ts",
    "compare": "node scripts/compare.ts",
    "test": "node test/run-all.ts",
    "test:quick": "node test/run-all.ts quick",
    "test:full": "node test/run-all.ts full",
    "test:ui": "node test/run-all.ts --only ui",
    "test:stress": "node test/run-all.ts stress",
    "test:wav": "node test/stream-wav.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "build:web": "node scripts/build-web.ts",
    "watch:web": "node --watch-path=web --watch-path=types scripts/build-web.ts",
    "benchmark": "node scripts/benchmark.ts",
    "benchmark:suite": "node scripts/benchmark-suite.ts",
    "manual": "node scripts/manual.ts",
    "app": "electron .",
    "dist:mac": "node scripts/bundle.ts --mac && electron-builder --mac",
    "dist:win": "node scripts/bundle.ts --win && electron-builder --win"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "dotenv": "^18.0.9",
    "sherpa-onnx-node": "^2.0.1",
    "transcribe-cpp": "^0.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/audioworklet": "0.0.100",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  },
  "author": "Live Transcriber",
  "build": {
    "appId": "ro.livetranscriber.app",
    "productName": "Live Transcriber",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "package.json",
      "server.ts",
      "lib/**",
      "public/**",
      "web/**",
      "desktop/main.ts",
      "docs/manual/*.pdf",
      "!**/*.md",
      "!node_modules/@elevenlabs/elevenlabs-js/dist/**"
    ],
    "extraResources": [
      {
        "from": "bundle/models",
        "to": "models"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "desktop/build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Live Transcriber listens to the meeting to turn speech into text. The audio never leaves this computer, unless you pick the ElevenLabs cloud model."
      },
      "artifactName": "Live-Transcriber-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Live Transcriber"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.png",
      "extraFiles": [
        {
          "from": "bundle/vc-runtime",
          "to": "."
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Live Transcriber",
      "artifactName": "Live-Transcriber-${version}-windows-setup.${ext}"
    }
  }
}
